# Backoffice API endpoints (used by Env switcher in admin UI)
NEXT_PUBLIC_DEV_API_URL=https://dev-api.balloads.com
NEXT_PUBLIC_STAGING_API_URL=https://staging-api.balloads.com
NEXT_PUBLIC_PROD_API_URL=https://api.balloads.com

# Optional one-time source DB for waitlist backfill script.
LEGACY_DATABASE_URL=
# Server-side backend base URL (no trailing slash). Used for waitlist backfill and MTN review proxy.
# In `next dev`, if unset, MTN review defaults to NEXT_PUBLIC_DEV_API_URL (or https://dev-api.balloads.com).
BACKEND_BASE_URL=
# Optional: allow admin proxy to target localhost backend URLs.
# Default behavior rewrites localhost targets to deployed APIs.
ALLOW_LOCAL_BACKEND_PROXY=false
# Optional per-environment MTN review backend shared secrets.
# If unset, `MTN_REVIEW_BACKEND_SECRET` is used for all envs.
MTN_REVIEW_BACKEND_SECRET_DEV=
MTN_REVIEW_BACKEND_SECRET_STAGING=
MTN_REVIEW_BACKEND_SECRET_PROD=

# Fallback shared secret for all envs (backwards compatible).
# Must match `MtnReview:BackendSharedSecret` on that API.
# In `next dev`, if neither the generic nor per-env secret is set, it defaults to `local-dev-mtn-review-backend-secret`.
MTN_REVIEW_BACKEND_SECRET=
# Optional admin token only for count verification in backfill script.
BACKOFFICE_BEARER_TOKEN=

# Firebase (Web Push in backoffice)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FCM_VAPID_KEY=

# Firebase Admin SDK (server-side push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
