# Backoffice API endpoints (used by Env switcher in admin UI)
NEXT_PUBLIC_DEV_API_URL=https://dev-api.balloads.com
NEXT_PUBLIC_STAGING_API_URL=https://staging-api.balloads.com
NEXT_PUBLIC_PROD_API_URL=https://api.balloads.com

# Optional one-time source DB for waitlist backfill script.
LEGACY_DATABASE_URL=
# Target backend base URL for waitlist backfill writes.
BACKEND_BASE_URL=
# Optional admin token only for count verification in backfill script.
BACKOFFICE_BEARER_TOKEN=

# Firebase (Web Push in backoffice)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FCM_VAPID_KEY=

# Firebase Admin SDK (server-side push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
