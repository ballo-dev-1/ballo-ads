// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CrmClient {
  id                String    @id @default(uuid())
  companyName       String    @map("company_name")
  industry          String
  region            String    @default("Lusaka, Zambia")
  interests         String[]  @default([]) // For granular interest-based targeting
  balloadsAccountId String    @unique @map("balloads_account_id")
  planTier          String    @map("plan_tier")
  accountStatus     String    @map("account_status") @default("active")
  healthScore       Int       @map("health_score") @default(100)
  creditsRemaining  Int       @map("credits_remaining") @default(0)
  lastActiveAt      DateTime? @map("last_active_at")
  signedUpAt        DateTime  @map("signed_up_at")
  syncedAt          DateTime  @map("synced_at") @updatedAt
  createdAt         DateTime  @default(now()) @map("created_at")

  events            CrmEvent[]
  messageLogs       CrmMessageLog[]

  @@map("crm_clients")
}

model CrmEvent {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    CrmClient @relation(fields: [clientId], references: [id])
  type      String   // e.g., "click", "open", "login", "purchase"
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("crm_events")
}

model CrmMessageLog {
  id         String    @id @default(uuid())
  campaignId String    @map("campaign_id")
  clientId   String    @map("client_id")
  client     CrmClient @relation(fields: [clientId], references: [id])
  channel    String    // sms, email, whatsapp, etc.
  status     String    @default("sent") // sent, delivered, failed, opened, clicked
  sentAt     DateTime  @default(now()) @map("sent_at")
  metadata   Json      @default("{}")

  @@map("crm_message_logs")
}

model CrmSegment {
  id              String    @id @default(uuid())
  name            String
  description     String?
  type            String    @default("dynamic")
  rules           Json      @default("[]")
  clientCount     Int       @map("client_count") @default(0)
  lastEvaluatedAt DateTime? @map("last_evaluated_at")
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("crm_segments")
}

model CrmJourney {
  id              String    @id @default(uuid())
  name            String
  status          String    @default("draft")
  triggerType     String    @map("trigger_type")
  triggerConfig   Json      @map("trigger_config") @default("{}")
  flowDefinition  Json      @map("flow_definition") @default("{\"nodes\":[],\"edges\":[]}")
  entrySegmentId  String?   @map("entry_segment_id")
  maxDurationDays Int       @map("max_duration_days") @default(7)
  entryMode       String    @map("entry_mode") @default("once_per_client")
  createdBy       String    @map("created_by")
  activatedAt     DateTime? @map("activated_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("crm_journeys")
}

model CrmCampaign {
  id          String    @id @default(uuid())
  name        String
  journeyId   String?   @map("journey_id")
  segmentId   String?   @map("segment_id")
  channel     String
  status      String    @default("draft")
  content     Json      @default("{}")
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  userLimit   Int       @map("user_limit") @default(100000)
  execSpeed   Int       @map("exec_speed") @default(500)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("crm_campaigns")
}

model CrmAuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorEmail String   @map("actor_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("crm_audit_logs")
}

model Waitlist {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // In production, this should be hashed!
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id              String   @id @default(uuid())
  title           String
  message         String
  type            String
  category        String   @default("operations")
  severity        String   @default("info")
  read            Boolean  @default(false)
  link            String?
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id")
  dedupeKey       String?  @map("dedupe_key")
  cooldownSeconds Int?     @map("cooldown_seconds")
  targetRoles     String[] @default([]) @map("target_roles")
  metadata        Json     @default("{}")
  source          String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([read, createdAt])
  @@index([type, createdAt])
  @@index([severity, createdAt])
  @@index([dedupeKey])
  @@map("Notification")
}

